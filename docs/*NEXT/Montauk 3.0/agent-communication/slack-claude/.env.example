# Slack-Claude Bot Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED: Slack Credentials
# =============================================================================

# Bot Token (starts with xoxb-)
# Get from: Slack App > OAuth & Permissions > Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-your-bot-token

# App Token (starts with xapp-)
# Get from: Slack App > Basic Information > App-Level Tokens
# Requires: connections:write scope
SLACK_APP_TOKEN=xapp-your-app-token

# =============================================================================
# OPTIONAL: Access Control
# =============================================================================

# Restrict bot to only respond to this Slack user ID
# Get your ID from: Slack > Profile > More > Copy member ID
# Leave empty to allow all users (not recommended)
SLACK_ALLOWED_USER=U12345678

# =============================================================================
# OPTIONAL: Claude Configuration
# =============================================================================

# Working directory for Claude (where your code lives)
# This is where .claude/settings.json and hooks will be loaded from
CLAUDE_WORKING_DIR=/Users/Sagiv/vscode

# Claude command (default: claude)
# Change if you have a different installation path
CLAUDE_COMMAND=claude

# Session timeout in milliseconds (default: 5 minutes)
# Sessions awaiting approval will be killed after this time
CLAUDE_SESSION_TIMEOUT_MS=300000

# =============================================================================
# OPTIONAL: Debug
# =============================================================================

# Enable debug logging
DEBUG=false
